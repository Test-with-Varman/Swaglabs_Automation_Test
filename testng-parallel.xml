<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Swaglabs Parallel Test Suite" verbose="2" parallel="classes" thread-count="3">
	<!-- 
	Parallel Execution Suite (By Classes)
	- Multiple test classes run in parallel (3 threads simultaneously)
	- Parallel Mode: "classes" (balanced approach)
	- Thread Count: 3 (runs 3 classes at the same time)
	- Best for: Faster execution, independent test classes
	- Execution Time: ~33% of sequential time (with 3 parallel threads)
	- Note: Requires thread-safe driver management and independent test data
	-->

	<!-- Test Group 1: Login & Product Tests (Parallel) -->
	<test name="Login Tests" preserve-order="true">
		<classes>
			<class name="testscripts.LoginTest" />
		</classes>
	</test>

	<!-- Test Group 2: Product Page Tests (Parallel) -->
	<test name="Product Page Tests" preserve-order="true">
		<classes>
			<class name="testscripts.ProductpageTest" />
		</classes>
	</test>

	<!-- Test Group 3: Cart Page Tests (Parallel) -->
	<test name="Cart Page Tests" preserve-order="true">
		<classes>
			<class name="testscripts.CartpageTest" />
		</classes>
	</test>

	<!-- Test Group 4: Checkout Page Tests (Parallel) -->
	<test name="Checkout Page Tests" preserve-order="true">
		<classes>
			<class name="testscripts.FInalCheckoutpageTest" />
		</classes>
	</test>

	<!-- Test Group 5: Info Page Tests (Parallel) -->
	<test name="Info Page Tests" preserve-order="true">
		<classes>
			<class name="testscripts.infopageTest" />
		</classes>
	</test>

	<!-- Test Group 6: End-to-End Tests (Parallel) -->
	<test name="End-to-End Tests" preserve-order="true">
		<classes>
			<class name="testscripts.EndtoEndTest" />
		</classes>
	</test>

</suite>
